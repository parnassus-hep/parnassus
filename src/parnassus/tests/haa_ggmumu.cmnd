! haa_ggmumu.cmnd -- BSM exotic Higgs decay H -> aa -> gg/mumu
! Uses Pythia8 BSM Higgs framework (H2 -> A3 A3)

! Beam settings
Beams:eCM = 13000.
Beams:idA = 2212
Beams:idB = 2212

! Enable BSM Higgs mode
Higgs:useBSM = on

! H2 production via gluon fusion (particle 35, used as BSM Higgs at 125 GeV)
HiggsBSM:gg2H2 = on
35:m0 = 125.0

! H2 SM-like couplings for production
HiggsH2:coup2u = 1.0
HiggsH2:coup2d = 1.0
HiggsH2:coup2l = 1.0
HiggsH2:coup2Z = 1.0
HiggsH2:coup2W = 1.0
HiggsH2:coup2A3A3 = 1.0

! Force H2 -> A0 A0 only
35:onMode = off
35:onIfAll = 36 36

! A0 pseudoscalar properties (particle 36)
36:m0 = 20.0

! A0 couplings for decay width calculation
HiggsA3:coup2d = 1.0
HiggsA3:coup2u = 1.0
HiggsA3:coup2l = 1.0

! Force A0 -> gg or mumu only
36:onMode = off
36:onIfAny = 21 13

! Parton shower / hadronisation
PartonLevel:MPI = on
PartonLevel:ISR = on
PartonLevel:FSR = on
HadronLevel:Hadronize = on

! Suppress output
Next:numberShowInfo = 0
Next:numberShowProcess = 0
Next:numberShowEvent = 0
