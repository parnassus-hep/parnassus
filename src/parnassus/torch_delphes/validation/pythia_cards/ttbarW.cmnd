! ttbar_W.cmnd
! This file contains parameters to generate ttbar -> W via Pythia8

! 1) Settings used in the main program.
! No need to set nEvents here - we determine that based on the number
! of workers and the total number of events needed

! 2) Settings related to the incoming beams
Beams:idA = 2212                    ! first beam proton
Beams:idA = 2212                    ! second beam proton
Beams:eCM = 13000.                  ! beam COM energy

! 3) Settings related to the decay we want to force
Top:gg2ttbar = on                   ! Gluon-gluon fusion to ttbar
Top:qqbar2ttbar = on                ! Quark-antiquark annihilation to ttbar
6:onMode = off                    ! Switch off all top decays
6:onIfAny = 24                    ! Switch on decay to W boson

! PhaseSpace:pTHatMin = 20.          ! Optionally tighten phase space
